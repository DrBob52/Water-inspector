{
  "name": "water-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "3D map app for inspecting lakes, rivers and bays: hydrography, water quality, impairments and biodiversity.",
  "workspaces": [
    "shared",
    "server",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"npm run dev -w server\" \"npm run dev -w app\"",
    "build": "npm run build -w app",
    "start": "npm run start -w server",
    "start:demo": "npm run build:demo -w app && DEMO_MODE=1 npm run start -w server",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
